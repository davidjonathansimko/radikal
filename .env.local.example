# RADIKAL Blog - Environment Variables / Umgebungsvariablen / Variabile de mediu
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local - it contains secrets!
#
# All of these must ALSO be added in Vercel:
# Project -> Settings -> Environment Variables (Production + Preview + Development)

# ---------- Supabase (required) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Site (required) ----------
NEXT_PUBLIC_SITE_URL=https://www.radikal.blog
NEXT_PUBLIC_CONTACT_EMAIL=radikal@radikal.blog

# ---------- Admin ----------
# Server-only. Receives comment report emails.
# Admin rights are NOT granted by this variable - they come from the Supabase JWT
# claim app_metadata.role === 'admin'. Grant it once with:
#   update auth.users
#   set raw_app_meta_data = coalesce(raw_app_meta_data,'{}'::jsonb) || '{"role":"admin"}'::jsonb
#   where email = 'your-admin@example.com';
ADMIN_EMAIL=your-admin@example.com

# ---------- Email: SMTP (contact form, newsletter, comment reports) ----------
# One single mail setup for the whole site - no external mail service needed.
SMTP_HOST=host286.checkdomain.de
SMTP_PORT=465
SMTP_USER=radikal@radikal.blog
SMTP_PASS=your-smtp-password

# ---------- Push notifications (STEP_261026A) ----------
# Generate the pair once:  node node_modules/web-push/src/cli.js generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:radikal@radikal.blog
# Any long random string; Vercel Cron sends it automatically as "Authorization: Bearer ..."
CRON_SECRET=your-long-random-secret

# ---------- Newsletter ----------
NEWSLETTER_API_KEY=your-newsletter-secret
NEXT_PUBLIC_NEWSLETTER_API_KEY=your-newsletter-secret

# ---------- Translation (DeepL) ----------
DEEPL_API_KEY=your-deepl-api-key

# ---------- Text-to-Speech (Google Cloud) ----------
GOOGLE_CLOUD_TTS_API_KEY=your-google-tts-api-key
